# Application
spring.application.name=MediSync
server.port=8080

# Database - PostgreSQL (Supabase)
# Format: jdbc:postgresql://host:port/database?user=xxx&password=xxx
DATABASE_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres?user=postgres&password=your_password

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# JWT - Generate a secure random key (min 256 bits)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long

# File Upload
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB
file.upload-dir=./uploads

# Resend API for emails
RESEND_API_KEY=re_xxxxxxxxx
resend.from-email=noreply@medisync.fr

# OpenAPI
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
